DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
PORT=

JWT_SECRET=
JWT_EXPIRES_IN=

# --- App ---
# Address people open the app at; used for every link in emails ("Sign in",
# approvals, shared drafts). Use the server's LAN IP or domain, not
# localhost. CLIENT_URL is still read if APP_URL is blank.
APP_URL=
CLIENT_URL=

# --- SMTP (all emails) ---
# Required for account emails (new user details, "E-mail new password",
# forgot-password code): without it a user is NOT created and a password
# is NOT reset. The older EMAIL_HOST / EMAIL_PORT / EMAIL_USER / EMAIL_PASS
# keys are still read when these are blank.
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address; defaults to SMTP_USER
SMTP_FROM=
# true = print every email (including temporary passwords and codes) to the
# server log instead of sending it. Local testing ONLY.
MAIL_DEV_LOG=false
